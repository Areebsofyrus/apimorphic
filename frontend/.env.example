# AI API Tester Studio — Environment Variables
# Copy this file to .env and fill in your values.

# Base URL of your NestJS backend (parses specs, generates scenarios, runs tests)
VITE_API_BASE_URL=http://localhost:3010

# Default target base URL pre-filled in the "Target Base URL" input in the UI
VITE_TARGET_BASE_URL=https://httpbin.org
